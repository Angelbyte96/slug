    "@tailwindcss/typography": "0.5.19",
    "@types/bcryptjs": "2.4.6",
    "@types/eslint": "9.6.1",
    "@types/node": "20.19.41",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@types/uuid": "9.0.8",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "autoprefixer": "10.5.0",
    "eslint": "9.39.4",
    "postcss": "8.5.15",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "prisma": "5.22.0",
