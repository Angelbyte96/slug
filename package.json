{
  "name": "@pheralb/slug",
  "version": "3.2.0",
  "author": "@pheralb_",
  "description": "A URL shortener built with T3 Stack",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint src --ext .ts,.tsx",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "pnpm db:generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:studio": "prisma studio",
    "db:push": "turso db shell slug < ./prisma/migrations/<migration_id>_init/migration.sql --location=<location>",
    "db:pscale:dump": "pscale database dump databasename databasebranch",
    "db:turso:dump": "turso db shell <database> .dump > dump.sql --location=<location>"
  },
  "dependencies": {
    "@auth/core": "0.30.0",
    "@auth/prisma-adapter": "2.11.2",
    "@hookform/resolvers": "3.10.0",
    "@libsql/client": "0.6.0",
    "@prisma/adapter-libsql": "5.22.0",
    "@prisma/client": "5.22.0",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@t3-oss/env-nextjs": "0.13.11",
    "bcryptjs": "2.4.3",
    "boring-avatars": "1.10.2",
    "cheerio": "1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "3.6.0",
    "eslint-config-next": "16.2.7",
    "js-confetti": "0.13.1",
    "lucide-react": "0.376.0",
    "next": "16.2.7",
    "next-auth": "5.0.0-beta.31",
    "next-themes": "0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.77.0",
    "react-qr-code": "2.0.21",
    "sonner": "1.4.41",
    "tailwind-merge": "2.2.2",
    "tailwindcss-animate": "1.0.7",
    "use-debounce": "10.1.1",
    "zod": "3.25.76"
  },
